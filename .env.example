# Database and queues
DATABASE_URL=postgresql://newsbot:newsbot@localhost:5432/newsbot?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BACKEND_PORT=4000
DATABASE_CONNECT_RETRIES=15
DATABASE_CONNECT_RETRY_MS=2000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ADMIN_API_KEY=

# Runtime switches
ENABLED_SOURCES=gdelt,google-news
SCHEDULE_JOBS=true

# Collection intervals (milliseconds)
GDELT_INTERVAL_MS=900000
GOOGLE_NEWS_INTERVAL_MS=900000
GOOGLE_NEWS_LOOKBACK_HOURS=48
REDDIT_INTERVAL_MS=180000
TIKTOK_INTERVAL_MS=1800000
X_INTERVAL_MS=900000
X_MAX_RESULTS=10
X_QUERIES_PER_RUN=1
X_DAILY_POST_BUDGET=200
SCORING_INTERVAL_MS=60000
LIFECYCLE_INTERVAL_MS=300000
DIGEST_INTERVAL_MS=10800000
DAILY_ROUNDUP_CRON=0 9 * * *

# Topics and watchlists (comma separated)
GDELT_QUERIES=viral animal,named animal,Florida man,odd local news,viral internet personality,internet character,crypto founder drama,crypto KOL,exchange executive drama,tokenized stock,political gaffe,political meme,meme format,viral phrase,TikTok sound,brand stunt,brand mascot,internet drama
GOOGLE_NEWS_QUERIES=viral animal,named animal,Florida man,odd local news,viral internet personality,internet character,crypto founder drama,crypto KOL,exchange executive drama,tokenized stock,political gaffe,political meme,meme format,viral phrase,TikTok sound,brand stunt,brand mascot,internet drama
REDDIT_SUBREDDITS=OutOfTheLoop,news,worldnews,CryptoCurrency,memes,animals
X_QUERIES=(viral animal OR zoo mascot OR famous pet OR florida man OR bizarre local news) lang:en,(viral creator OR internet personality OR crypto founder OR crypto KOL OR exchange executive) lang:en,(political gaffe OR political meme OR meme format OR viral phrase OR tiktok sound) lang:en,(brand stunt OR brand mascot OR internet drama OR tokenized stock) lang:en

# Provider credentials. Missing credentials disable only that provider.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=viral-news-intelligence/1.0
REDDIT_ACCESS_TOKEN=
TIKTOK_CREATIVE_CENTER_FEED_URL=
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Ollama Cloud (create an API key at https://ollama.com/settings/keys)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_MS=90000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Detection and scoring
CLUSTER_SIMILARITY_THRESHOLD=0.42
TREND_LOOKBACK_HOURS=72
METRIC_LOOKBACK_MINUTES=60
WEIGHT_VELOCITY=0.25
WEIGHT_ACCELERATION=0.20
WEIGHT_ENGAGEMENT=0.15
WEIGHT_CROSS_PLATFORM=0.20
WEIGHT_NOVELTY=0.10
WEIGHT_SOURCE_STRENGTH=0.10
THRESHOLD_MONITORING=30
THRESHOLD_RISING=50
THRESHOLD_HOT=70
THRESHOLD_BREAKOUT=85
PUBLICATION_SCORE_DELTA=5
TREND_EXPIRY_HOURS=48
