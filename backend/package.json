    "@nestjs/platform-fastify": "^11.1.6",
    "@prisma/client": "6.12.0",
    "bullmq": "^5.58.5",
    "fast-xml-parser": "^5.2.5",
    "ioredis": "^5.7.0",
    "playwright-core": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prisma": "6.12.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
